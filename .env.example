# OpenAI
OPENAI_API_KEY=
# Optional override. The default is gpt-5.6.
OPENAI_MODEL=gpt-5.6

# Google OAuth (enable the Google Drive API)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
GOOGLE_TOKEN_SECRET=

# Your production URL, without a trailing slash.
# Add this URL + /api/google/callback as an authorized Google OAuth redirect URI.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WordPress publishing (use a dedicated WordPress Application Password)
WORDPRESS_SITE_URL=https://example.com
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
# Comma-separated Google accounts that may publish. Defaults to accounts@amplifylaw.ai.
WORDPRESS_ALLOWED_GOOGLE_EMAILS=accounts@amplifylaw.ai

# Optional migration/emergency fallback. New clients can be added in /clients.
AMPLIFY_CLIENTS_JSON=
